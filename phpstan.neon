parameters:
	level: 0
	phpVersion: 70400

	paths:
		- php
		- plugins
		- tests
		# The only PHP outside php/ and plugins/, and the home of the
		# Requirements class the tests under tests/php exercise.
		- env_check.php
		# Snoopy is a .php file in all but name, and PHPStan only walks
		# .php when it scans a directory, so it is named here explicitly.
		- php/Snoopy.class.inc

	ignoreErrors:
		# Each test file is run on its own by tests/php-test.sh, so a test
		# stands up the collaborators it needs itself:
		#
		#     if(!class_exists('FileUtil')) { class FileUtil { ... } }
		#
		# At runtime that declaration is the only FileUtil there is. PHPStan
		# reads the whole tree at once, finds the shipped class of the same
		# name first, and measures the test's calls against it -- so every
		# member the stand-in adds reads as missing. The names come from the
		# test, not from the code under test, and no shipped class is being
		# described, so these say nothing about either.
		#
		# Named class by class rather than by identifier, so a static call
		# that is simply wrong -- on a class no test stands in for -- still
		# fails the build, as does everything else level 0 reports about
		# tests/: unknown classes and functions, undefined variables.
		-
			identifier: staticProperty.notFound
			message: '#undefined static property (FileUtil|Snoopy|Torrent|rTorrent|ruTrackerChecker|rXMLRPCRequest)::#'
			path: tests/*
		-
			identifier: staticMethod.notFound
			message: '#undefined static method (FileUtil|Snoopy|Torrent|rTorrent|ruTrackerChecker|rXMLRPCRequest)::#'
			path: tests/*

		# SnoopyConnectTest reads php/Snoopy.class.inc and re-declares the
		# class inside a namespace with eval(), so that the fixture's own
		# fsockopen() is the one connect() reaches. A class that comes into
		# existence only when the test runs cannot be seen before it does.
		-
			identifier: class.notFound
			message: '#SnoopyConnectFixture.(Snoopy|TorrentFetch)#'
			path: tests/php/SnoopyConnectTest.php

		# PHPStan normalizes the literal namespace sequence \r in regex
		# matching; exact messages keep this dynamically loaded class name.
		-
			identifier: class.notFound
			rawMessages:
				- 'Call to static method fetchStatusDetail() on an unknown class SnoopyConnectFixture\ruTrackerChecker.'
				- 'Call to static method classifyFetchError() on an unknown class SnoopyConnectFixture\ruTrackerChecker.'
			path: tests/php/SnoopyConnectTest.php

		# Standalone files choose these declared test doubles instead of the
		# production classes PHPStan indexes first in its combined tree.
		-
			identifier: staticProperty.notFound
			message: '#undefined static property rAutoTools::#'
			paths:
				- tests/plugins/autotools/FinishedHookTest.php
				- tests/plugins/autotools/MoveNoticeTest.php
				- tests/plugins/autotools/MoveRenameCapabilityTest.php
				- tests/plugins/autotools/NonMoveTransactionTest.php
		-
			identifier: staticProperty.notFound
			message: '#undefined static property (rTorrentSettings|CachedEcho)::#'
			path: tests/plugins/check_port/PortSelectionTest.php
		-
			identifier: staticProperty.notFound
			message: '#undefined static property User::#'
			path: tests/plugins/datadir/RecoveryProfilesTest.php
		-
			identifier: staticProperty.notFound
			message: '#undefined static property RuTrackerMetaFetch::#'
			paths:
				- tests/plugins/rutracker_check/CheckerTest.php
				- tests/plugins/rutracker_check/UpdatePassTest.php
		-
			identifier: staticProperty.notFound
			message: '#undefined static property RuTrackerState::#'
			path: tests/plugins/rutracker_check/ReplacementBackoffRaceTest.php

		# UpstreamMoveTest evaluates the real actor inside a namespace with
		# Cut recorders for filesystem calls, so these types exist at runtime.
		-
			identifier: class.notFound
			message: '#UpstreamMoveFileCut.(Cut|AutoToolsUpstreamMove)#'
			path: tests/plugins/autotools/UpstreamMoveTest.php

		# These adapters are nowdoc class declarations evaluated on demand by
		# UpdateTest. The recovery adapter is a regular file so anonymous
		# subclasses can also be analyzed through their actual parent.
		-
			identifier: class.notFound
			message: '#Retrackers(HistoricalQueueAdapter|LifecycleQueueAdapter|WholeRunTestAdapter|AnonymousStageTestDouble|StagePreflightAdapter|ScriptedFileReader|RecordingTorrentProjector|ReplacingFileReader|ErroredTorrentProjector)#'
			path: tests/plugins/retrackers/UpdateTest.php
		-
			identifier: staticProperty.notFound
			message: '#undefined static property rSCGITransport::#'
			path: tests/plugins/retrackers/UpdateTest.php
		-
			identifier: staticProperty.notFound
			message: '#undefined static property rTorrentSettings::\$cap#'
			path: tests/plugins/retrackers/WorkerCapTest.php

		# The erasedata fixtures evaluate these production definitions in
		# namespaces with deterministic filesystem collaborators.
		-
			identifier: function.notFound
			message: '#ErasedataCleanupArmFixture.erasedataArmObsoleteCleanupRun#'
			path: tests/plugins/erasedata/CleanupRenamePreflightTest.php
		-
			identifier: function.notFound
			message: '#ErasedataRetirementScanFixture.erasedataRetirementScan#'
			path: tests/plugins/erasedata/RetirementScanTest.php
		-
			identifier: class.notFound
			message: '#ErasedataCaptureOwnershipProbe.Filesystem#'
			path: tests/plugins/erasedata/NativeCompletionTest.php

	# GeoIp2 ships as a phar that plugins/geoip/lookup.php requires at
	# runtime. PHPStan reads class declarations straight out of it, so the
	# classes resolve without the phar being unpacked or excluded.
	scanDirectories:
		- phar://%currentWorkingDirectory%/plugins/geoip/geoip2.phar/src

	# The CLI tool is imported dynamically by its test; index its owning class
	# without executing the standalone entry point.
	scanFiles:
		- tools/escaped-values-scan.php
