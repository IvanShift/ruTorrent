root = true

[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml,json}]
indent_style = space
indent_size = 2

# Captured HTTP responses are byte witnesses; preserve their wire format.
[tests/php/fixtures/rutracker-https-304/conditional.headers]
end_of_line = crlf
trim_trailing_whitespace = false

[tests/php/fixtures/rutracker-https-304/forum-7.json]
insert_final_newline = false

# The live Tapochek page byte for byte (see .gitattributes): it mixes CRLF
# and LF line ends, has trailing spaces and no final newline.
[tests/plugins/rutracker_check/fixtures/tapochek-p7-2026-09-25.html]
end_of_line = unset
insert_final_newline = false
trim_trailing_whitespace = false

# The live Kinozal mirror pages of 2026-10-15 byte for byte (see
# .gitattributes): they mix CRLF and LF line ends, and tests pin their md5.
[tests/plugins/rutracker_check/fixtures/kinozal-mirror-missing-download-2026-10-15.html]
end_of_line = unset

[tests/plugins/loginmgr/fixtures/kinozal-mirror-login-2026-10-15.html]
end_of_line = unset
